{
// ============================================================
// EINGABE / AUSGABE
// ============================================================

```
// Rohvideo, aus dem der Clip ausgeschnitten werden soll.
//
// Der Pfad kann relativ zur config-Datei oder absolut
// angegeben werden.
//
// Beispiele:
//   "input": "videos/spaziergang.mp4"
//
//   "input": "C:/Videos/spaziergang.mp4"
"input": "videos/spaziergang.mp4",


// Name und Pfad der fertigen Clip-Datei.
//
// Relativ zur config-Datei oder absolut.
//
// Beispiel:
//   "output": "clips/spaziergang_01.mp4"
"output": "clips/spaziergang_01.mp4",


// ============================================================
// ZEITAUSSCHNITT
// ============================================================

// Start des Ausschnitts im Rohvideo.
//
// Folgende Schreibweisen sind möglich:
//
//   "5"
//   "00:05"
//   "01:15"
//   "00:01:15.500"
//
// Auch Dezimalwerte sind möglich:
//
//   5.5
//
// Der Clip beginnt hier.
"start": "00:05",


// Ende des Ausschnitts.
//
// Muss größer als "start" sein.
//
// Beispiel:
//
//   start = 00:05
//   end   = 00:12
//
// ergibt einen 7 Sekunden langen Clip.
"end": "00:12",


// ============================================================
// ZIELFORMAT
// ============================================================

// Auflösung des fertigen Clips.
//
// Format:
//
//   "BREITE x HÖHE"
//
// Typische Social-Media-Auflösung:
//
//   "1080x1920"  = 9:16 Hochformat
//
// Weitere Beispiele:
//
//   "720x1280"   = 9:16
//   "1080x1080"  = 1:1
//   "1920x1080"  = 16:9
//
// Gültig:
// beliebige positive Breite x positive Höhe.
"resolution": "1080x1920",


// ============================================================
// CROP-MODUS
// ============================================================

// Bestimmt, wie aus dem ursprünglichen Bild der gewünschte
// Ausschnitt für das Zielformat erzeugt wird.
//
// ------------------------------------------------------------
// "dog"
// ------------------------------------------------------------
//
// Intelligenter Crop:
//
// Das lokale YOLO-Modell sucht Hunde im Video.
// Der virtuelle Kameraausschnitt folgt dem Hund.
//
// Zusätzlich werden berücksichtigt:
//
//   - Größe des Hundes
//   - Position des Hundes
//   - Sicherheitsrand
//   - Bewegung des Hundes
//   - mehrere Hunde
//   - kurzzeitige Fehldetektionen
//
// ------------------------------------------------------------
// "center"
// ------------------------------------------------------------
//
// Kein KI-Tracking.
//
// Es wird einfach ein Ausschnitt aus der Bildmitte verwendet.
//
// Dieser Modus ist schneller und benötigt kein YOLO-Modell.
//
// Gültige Werte:
//
//   "dog"
//   "center"
"crop": "dog",


// ============================================================
// YOLO-MODELL
// ============================================================

// Pfad bzw. Name des lokalen YOLO-Modells.
//
// Beispiel:
//
//   "yolo11n.pt"
//
// Beim ersten Verwenden lädt Ultralytics dieses Modell
// gegebenenfalls automatisch herunter.
//
// Danach arbeitet die Erkennung lokal.
//
// Alternativ kann hier ein eigener lokaler Pfad angegeben
// werden:
//
//   "models/yolo11n.pt"
//
// Gültig:
// Pfad zu einem kompatiblen YOLO-Modell.
"model": "yolo11n.pt",


// ============================================================
// ERKENNUNGSSICHERHEIT
// ============================================================

// Mindestwahrscheinlichkeit, mit der YOLO einen erkannten
// Hund akzeptiert.
//
// Bereich:
//
//   0.0 bis 1.0
//
// Beispiele:
//
//   0.20 = viele Erkennungen, aber eventuell mehr Fehler
//   0.35 = guter Ausgangswert
//   0.50 = strengere Erkennung
//   0.70 = sehr strenge Erkennung
//
// Wenn der Hund häufig übersehen wird:
// Wert etwas reduzieren.
//
// Wenn viele falsche Erkennungen auftreten:
// Wert erhöhen.
"confidence": 0.35,


// ============================================================
// WIE OFT SOLL YOLO NACH DEM HUND SUCHEN?
// ============================================================

// Abstand zwischen zwei KI-Erkennungen in Sekunden.
//
// Beispiel:
//
//   0.20 = ungefähr 5 Erkennungen pro Sekunde
//
//   0.10 = ungefähr 10 Erkennungen pro Sekunde
//
//   0.50 = ungefähr 2 Erkennungen pro Sekunde
//
// Kleinerer Wert:
//   genauer bei schnellen Bewegungen,
//   aber mehr Rechenaufwand.
//
// Größerer Wert:
//   schneller,
//   aber der Hund kann sich zwischen den Erkennungen
//   weiter bewegen.
//
// Gültig:
// positive Zahl > 0.
"detection_interval": 0.20,


// ============================================================
// KAMERA-GLÄTTUNG
// ============================================================

// Wie schnell die virtuelle Kamera auf eine neue Position
// des Hundes reagiert.
//
// Niedrige Werte:
//
//   0.05 = sehr weich / langsam
//   0.10 = weich
//   0.18 = guter Ausgangspunkt
//   0.25 = reagiert schneller
//
// Hohe Werte:
//
//   0.50 = deutlich direkter
//   0.80 = sehr schnelle Reaktion
//   1.00 = praktisch keine Glättung
//
// Gültig:
// ungefähr 0.0 bis 1.0.
//
// Für ruhige Social-Media-Videos würde ich zunächst
// 0.15 bis 0.25 verwenden.
"smoothing": 0.18,


// ============================================================
// SICHERHEITSRAND UM DEN HUND
// ============================================================

// Zusätzlicher Rand um die erkannte Hunde-Bounding-Box.
//
// Beispiel:
//
//   0.10 = 10 % zusätzlicher Rand
//   0.20 = 20 % zusätzlicher Rand
//   0.30 = 30 % zusätzlicher Rand
//
// Ein größerer Wert bedeutet:
//
//   mehr Umgebung sichtbar
//   geringere Gefahr, dass der Hund angeschnitten wird
//
// Ein kleinerer Wert bedeutet:
//
//   Hund wird größer im Bild
//   Ausschnitt ist enger
//
// Gültig:
// Zahl >= 0.
"margin": 0.20,


// ============================================================
// GRUNDLEGENDER ZOOM
// ============================================================

// Grundsätzlicher Zoom-Faktor des intelligenten Crops.
//
//   1.00 = kein zusätzlicher Zoom
//   1.05 = leicht näher
//   1.15 = deutlich näher
//   1.50 = stark näher
//
// Der tatsächliche Zoom kann trotzdem automatisch reduziert
// werden, wenn der Hund sonst nicht vollständig ins Bild passt.
//
// Gültig:
// positive Zahl.
"zoom": 1.05,


// ============================================================
// MINDEST-ZOOM
// ============================================================

// Untergrenze für den Zoom.
//
// Ein Wert unter 1 erlaubt dem System, weiter herauszuzoomen,
// wenn der Hund besonders groß ist oder mehrere Hunde
// gleichzeitig ins Bild passen müssen.
//
// Beispiele:
//
//   1.00 = nicht herauszoomen
//   0.90 = leicht herauszoomen erlaubt
//   0.85 = etwas stärkeres Herauszoomen erlaubt
//
// Gültig:
// positive Zahl.
"min_zoom": 0.85,


// ============================================================
// MAXIMALER ZOOM
// ============================================================

// Obergrenze für den Zoom.
//
// Verhindert, dass der virtuelle Kameraausschnitt
// zu stark hineinzoomt.
//
// Beispiele:
//
//   1.20 = relativ zurückhaltend
//   1.35 = moderater Zoom
//   1.50 = stärkerer Zoom
//
// Gültig:
// positive Zahl >= min_zoom.
"max_zoom": 1.35,


// ============================================================
// MEHRERE HUNDE
// ============================================================

// Verhalten, wenn mehrere Hunde erkannt werden.
//
// ------------------------------------------------------------
// "all"
// ------------------------------------------------------------
//
// Alle erkannten Hunde werden berücksichtigt.
//
// Der Crop wird so gewählt, dass möglichst alle Hunde
// gleichzeitig im Bild bleiben.
//
// Gut geeignet, wenn mehrere Hunde gemeinsam gefilmt werden.
//
// ------------------------------------------------------------
// "largest"
// ------------------------------------------------------------
//
// Nur der größte erkannte Hund wird verfolgt.
//
// Sinnvoll, wenn beispielsweise im Hintergrund noch ein
// kleiner Hund auftaucht, der ignoriert werden soll.
//
// ------------------------------------------------------------
// "strongest"
// ------------------------------------------------------------
//
// Es wird der Hund mit der höchsten Erkennungssicherheit
// verfolgt.
//
// Gültige Werte:
//
//   "all"
//   "largest"
//   "strongest"
"multi_dog_mode": "all",


// ============================================================
// OPTIONAL: KAMERA-PLAN SPEICHERN
// ============================================================

// Wenn true, wird zusätzlich eine JSON-Datei mit den
// berechneten Kamera-Positionen gespeichert.
//
// Das ist hauptsächlich für Kontrolle, Debugging und spätere
// Weiterentwicklung interessant.
//
// Gültige Werte:
//
//   true
//   false
//
// Im normalen Betrieb:
//   false
"save_camera_plan": false
```

}
